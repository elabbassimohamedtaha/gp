<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vue.EmployeController"
      style="-fx-padding: 20;">
    <HBox spacing="10">
        <Label text="Page Employe" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button text="Deconnexion" onAction="#deconnexion"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>
    <HBox spacing="10">
        <TextField fx:id="rechercheField" promptText="Rechercher par nom..." prefWidth="300"/>
        <Button text="Rechercher" onAction="#rechercher"/>
        <Button text="Actualiser" onAction="#actualiser"/>
        <Button text="Stock Faible" onAction="#voirStockFaible"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
    </HBox>
    <Label fx:id="alerteLabel" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
    <TableView fx:id="tableView" prefHeight="500">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="40"/>
            <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="descCol" text="Description" prefWidth="180"/>
            <TableColumn fx:id="prixCol" text="Prix" prefWidth="80"/>
            <TableColumn fx:id="quantiteCol" text="Quantite" prefWidth="80"/>
            <TableColumn fx:id="dateCol" text="Date Expiration" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>