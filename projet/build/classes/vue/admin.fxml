<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vue.AdminController"
      style="-fx-padding: 20;">
    <HBox spacing="10">
        <Label text="Page Admin" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button text="Déconnexion" onAction="#deconnexion"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>
    <HBox spacing="10">
        <TextField fx:id="nomField" promptText="Nom"/>
        <TextField fx:id="descField" promptText="Description"/>
        <TextField fx:id="prixField" promptText="Prix"/>
        <TextField fx:id="quantiteField" promptText="Quantite"/>
        <TextField fx:id="dateField" promptText="Date expiration (YYYY-MM-DD)"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Ajouter" onAction="#ajouterMedicament"/>
        <Button text="Modifier" onAction="#modifierMedicament"/>
        <Button text="Supprimer" onAction="#supprimerMedicament"/>
        <Button text="Actualiser" onAction="#actualiser"/>
    </HBox>
    <HBox spacing="10">
        <TextField fx:id="rechercheField" promptText="Rechercher par nom..." prefWidth="300"/>
        <Button text="Rechercher" onAction="#rechercher"/>
        <Button text="Stock Faible" onAction="#voirStockFaible"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
    </HBox>
    <Label fx:id="alerteLabel" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
    <TableView fx:id="tableView" prefHeight="350">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="40"/>
            <TableColumn fx:id="nomCol" text="Nom" prefWidth="120"/>
            <TableColumn fx:id="descCol" text="Description" prefWidth="150"/>
            <TableColumn fx:id="prixCol" text="Prix" prefWidth="80"/>
            <TableColumn fx:id="quantiteCol" text="Quantite" prefWidth="80"/>
            <TableColumn fx:id="dateCol" text="Date Expiration" prefWidth="130"/>
        </columns>
    </TableView>
    <Label text="Gestion Employes" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <HBox spacing="10">
        <TextField fx:id="empUsernameField" promptText="Username"/>
        <TextField fx:id="empPasswordField" promptText="Password"/>
        <Button text="Ajouter Employe" onAction="#ajouterEmploye"/>
        <Button text="Supprimer Employe" onAction="#supprimerEmploye"/>
    </HBox>
    <TableView fx:id="employeTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="empIdCol" text="ID" prefWidth="40"/>
            <TableColumn fx:id="empUsernameCol" text="Username" prefWidth="150"/>
            <TableColumn fx:id="empRoleCol" text="Role" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
