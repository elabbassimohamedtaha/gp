<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vue.BibliothequeController"
      style="-fx-padding: 20;">
    <Label text="Gestion Pharmacie" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <HBox spacing="10">
        <TextField fx:id="nomField" promptText="Nom"/>
        <TextField fx:id="descField" promptText="Description"/>
        <TextField fx:id="prixField" promptText="Prix"/>
        <TextField fx:id="quantiteField" promptText="Quantite"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Ajouter" onAction="#ajouterMedicament"/>
        <Button text="Modifier" onAction="#modifierMedicament"/>
        <Button text="Supprimer" onAction="#supprimerMedicament"/>
        <Button text="Actualiser" onAction="#actualiser"/>
    </HBox>
    <TableView fx:id="tableView" prefHeight="400">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="descCol" text="Description" prefWidth="200"/>
            <TableColumn fx:id="prixCol" text="Prix" prefWidth="100"/>
            <TableColumn fx:id="quantiteCol" text="Quantite" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>